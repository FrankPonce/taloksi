{
  "expo": {
    "name": "Taloksi",
    "slug": "taloksi",
    "scheme": "taloksi",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1B2748",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.frankponce.taloksi"
    },
    "android": {
      "package": "dev.frankponce.taloksi"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-asset",
      "expo-font"
    ]
  }
}
