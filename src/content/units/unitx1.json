  "grammar": [
    {
      "id": "g_swearing",
      "title": "Kiroilun kielioppi",
      "titleEn": "The grammar of swearing",
      "blocks": [
        { "type": "p", "text": "Finnish swearing is not about bodies or mothers. It is mostly devils, hell and one very versatile anatomical word. Even swear words obey the case system, which makes them surprisingly good grammar practice." },
        { "type": "table", "head": ["Word", "Strength", "Where it is OK"], "rows": [["hitto, hemmetti", "1/5", "Anywhere"], ["paska", "2/5", "Friends, casual work"], ["helvetti", "3/5", "Friends"], ["saatana, perkele", "4/5", "Friends, stubbed toes"], ["vittu", "5/5", "Close friends only"]] },
        { "type": "tip", "text": "Voi + swear word is the all-purpose reaction: 'Voi hitto!' (mild) up to 'Voi vittu!' (strong)." },
        { "type": "example", "fi": "Mitä helvettiä?", "en": "What the hell?" },
        { "type": "p", "text": "As an intensifier the swear goes into the genitive and sits in front of the word: vittu → vitun, helvetti → helvetin, perkele → perkeleen. Note the consonant gradation tt → t." },
        { "type": "example", "fi": "Helvetin kylmä.", "en": "Hellishly cold." },
        { "type": "tip", "text": "Read the room. Finns swear a lot with friends and almost never with strangers, customers or at the doctor's. When unsure, 'hitto' is always safe." }
      ]
    },
    {
      "id": "g_rection",
      "title": "Tykätä + -sta, rakastaa + partitiivi",
      "titleEn": "Verbs that demand a case",
      "blocks": [
        { "type": "p", "text": "Many Finnish verbs decide which case their object takes. This is called rektio (rection). You cannot guess it, so learn each verb together with its case." },
        { "type": "table", "head": ["Verb", "Case", "Example"], "rows": [["tykätä", "-sta / -stä", "Tykkään sinusta."], ["pitää", "-sta / -stä", "Pidän kahvista."], ["rakastaa", "partitive", "Rakastan sinua."], ["ihastua", "-Vn (illative)", "Ihastuin sinuun."]] },
        { "type": "example", "fi": "Tykkään sinusta.", "en": "I like you.", "puhe": "Mä tykkään susta." },
        { "type": "example", "fi": "Minä rakastan sinua.", "en": "I love you.", "puhe": "Mä rakastan sua." },
        { "type": "tip", "text": "'Minä rakastan sinua' is a big sentence in Finland. People say it rarely and mean it completely. 'Tykkään sinusta' is the normal thing to say when dating." }
      ]
    }
  ]
