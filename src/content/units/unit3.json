        { "id": "w_mehu", "fi": "mehu", "en": "juice" },
        { "id": "w_olut", "fi": "olut", "en": "beer", "puhe": "kalja" },
        { "id": "w_juoda", "fi": "juoda", "en": "to drink", "altEn": ["drink"] }
      ],
      "sentences": [
        { "id": "s_u3l2_1", "fi": "Juon kahvia joka aamu.", "en": "I drink coffee every morning.", "puhe": "Mä juon kahvii joka aamu.", "speaker": "aino" },
        { "id": "s_u3l2_2", "fi": "Haluatko teetä vai kahvia?", "en": "Do you want tea or coffee?", "altEn": ["Would you like tea or coffee?"], "puhe": "Haluuks sä teetä vai kahvii?", "speaker": "aino" },
        { "id": "s_u3l2_3", "fi": "Lasi vettä, kiitos.", "en": "A glass of water, please.", "altEn": ["A glass of water, thanks.", "Glass of water, please."], "speaker": "samir" },
        { "id": "s_u3l2_4", "fi": "Suomalaiset juovat paljon kahvia.", "en": "Finns drink a lot of coffee.", "altEn": ["Finnish people drink a lot of coffee.", "Finns drink lots of coffee."], "puhe": "Suomalaiset juo tosi paljon kahvii.", "speaker": "helvi" },
        { "id": "s_u3l2_5", "fi": "Maito on kylmää.", "en": "The milk is cold.", "altEn": ["Milk is cold."], "speaker": "helvi" }
      ],
      "fill": [
        { "id": "f_u3l2_1", "before": "Juon", "after": "joka aamu.", "answer": "kahvia", "options": ["kahvi", "kahvia", "kahvin"], "en": "I drink coffee every morning." }
      ]
    },
