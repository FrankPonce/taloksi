      "sentences": [
        { "id": "s_u3l0_1", "fi": "Yksi kahvi, kiitos.", "en": "One coffee, please.", "altEn": ["A coffee, please.", "One coffee, thanks."], "puhe": "Yks kahvi, kiitos.", "speaker": "aino" },
        { "id": "s_u3l0_2", "fi": "Kolme plus neljä on seitsemän.", "en": "Three plus four is seven.", "altEn": ["Three plus four equals seven."], "puhe": "Kolme plus neljä on seittemän.", "speaker": "mikko" },
        { "id": "s_u3l0_3", "fi": "Bussi numero kuusi tulee.", "en": "Bus number six is coming.", "altEn": ["The number six bus is coming.", "Bus six is coming."], "puhe": "Kutonen tulee.", "note": "In speech, buses go by their number names: kutonen is “the six”.", "speaker": "mikko" },
        { "id": "s_u3l0_4", "fi": "Suomessa on kaksi kieltä: suomi ja ruotsi.", "en": "Finland has two languages: Finnish and Swedish.", "altEn": ["There are two languages in Finland: Finnish and Swedish."], "puhe": "Suomessa on kaks kieltä: suomi ja ruotsi.", "fact": "Finnish and Swedish are Finland’s two national languages. The Sámi languages also have official status in the Sámi homeland in the north.", "speaker": "mikko" },
        { "id": "s_u3l0_5", "fi": "Turussa on kaksi yliopistoa.", "en": "There are two universities in Turku.", "altEn": ["Turku has two universities."], "puhe": "Turussa on kaks yliopistoa.", "fact": "The University of Turku teaches mainly in Finnish, Åbo Akademi University in Swedish.", "speaker": "mikko" }
      ],
