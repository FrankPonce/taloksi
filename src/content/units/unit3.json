        { "id": "w_maksaa", "fi": "maksaa", "en": "to cost", "altEn": ["cost", "to pay", "pay"] },
        { "id": "w_euro", "fi": "euro", "en": "euro" },
        { "id": "w_kallis", "fi": "kallis", "en": "expensive" },
        { "id": "w_halpa", "fi": "halpa", "en": "cheap" },
        { "id": "w_kauppa", "fi": "kauppa", "en": "shop", "altEn": ["store"] },
        { "id": "w_kortti", "fi": "kortti", "en": "card" },
        { "id": "w_kassi", "fi": "kassi", "en": "bag", "altEn": ["shopping bag"] }
      ],
      "sentences": [
        { "id": "s_u3l3_1", "fi": "Paljonko tämä maksaa?", "en": "How much does this cost?", "altEn": ["How much is this?"], "puhe": "Paljonks tää maksaa?", "speaker": "helvi" },
        { "id": "s_u3l3_2", "fi": "Se maksaa viisi euroa.", "en": "It costs five euros.", "altEn": ["That costs five euros.", "It is five euros."], "puhe": "Se maksaa viis euroo.", "speaker": "aino" },
        { "id": "s_u3l3_3", "fi": "Tämä on liian kallis.", "en": "This is too expensive.", "puhe": "Tää on liian kallis.", "speaker": "helvi" },
        { "id": "s_u3l3_4", "fi": "Voinko maksaa kortilla?", "en": "Can I pay by card?", "altEn": ["Can I pay with a card?", "Can I pay with card?"], "puhe": "Voinks mä maksaa kortilla?", "speaker": "aino" },
        { "id": "s_u3l3_5", "fi": "Kauppa on auki.", "en": "The shop is open.", "altEn": ["The store is open."], "speaker": "aino" },
        { "id": "s_u3l3_6", "fi": "Tarvitsetko kassin?", "en": "Do you need a bag?", "puhe": "Tarviiks kassin?", "note": "You'll hear this at every K-Market and S-Market checkout.", "speaker": "aino" }
      ],
      "fill": [
