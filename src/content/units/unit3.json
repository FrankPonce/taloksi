        { "id": "w_juusto", "fi": "juusto", "en": "cheese" },
        { "id": "w_omena", "fi": "omena", "en": "apple", "altEn": ["an apple"] },
        { "id": "w_kala", "fi": "kala", "en": "fish" },
        { "id": "w_liha", "fi": "liha", "en": "meat" },
