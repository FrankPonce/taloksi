        { "id": "w_haluaisin", "fi": "haluaisin", "en": "I would like", "altEn": ["I'd like"] }
      ],
      "sentences": [
        { "id": "s_u3l4_1", "fi": "Haluaisin kupin kahvia.", "en": "I would like a cup of coffee.", "puhe": "Mä ottaisin kupin kahvii.", "speaker": "aino" },
        { "id": "s_u3l4_2", "fi": "Otan korvapuustin.", "en": "I'll take a cinnamon roll.", "altEn": ["I will take a cinnamon roll.", "I'll have a cinnamon roll.", "I take a cinnamon roll.", "I'll take a cinnamon bun."], "puhe": "Mä otan korvapuustin.", "speaker": "aino" },
        { "id": "s_u3l4_3", "fi": "Täällä vai mukaan?", "en": "For here or to go?", "altEn": ["Here or to go?", "For here or takeaway?", "Eat in or take away?"], "speaker": "aino" },
        { "id": "s_u3l4_4", "fi": "Täällä, kiitos.", "en": "For here, please.", "altEn": ["Here, please.", "For here, thanks."], "speaker": "pekka" },
        { "id": "s_u3l4_5", "fi": "Onko teillä kauramaitoa?", "en": "Do you have oat milk?", "puhe": "Onks teil kauramaitoo?", "speaker": "samir" }
      ],
      "fill": [
        { "id": "f_u3l4_1", "before": "Haluaisin kupin", "after": ".", "answer": "kahvia", "options": ["kahvi", "kahvia", "kahvissa"], "en": "I would like a cup of coffee." }
      ]
    }
  ],
  "grammar": [
    {
      "id": "g_partitive",
      "title": "Partitiivi (2)",
      "titleEn": "The partitive, part 2: food and 'some'",
      "blocks": [
        { "type": "p", "text": "Use the partitive for an unspecified amount of something uncountable — think 'some'." },
        { "type": "table", "head": ["Basic form", "Partitive", "Example"], "rows": [["kahvi", "kahvia", "Juon kahvia."], ["leipä", "leipää", "Syön leipää."], ["vesi", "vettä", "Lasi vettä."], ["tee", "teetä", "Haluatko teetä?"], ["maito", "maitoa", "Ostan maitoa."]] },
        { "type": "p", "text": "A whole, countable thing takes the -n ending instead: 'Syön omenan' (I eat an/the apple — all of it)." },
        { "type": "tip", "text": "Negative sentences always use the partitive object: 'Syön lihan' → 'En syö lihaa'." }
      ]
    },
    {
      "id": "g_question_ko",
      "title": "Kysymykset: -ko / -kö",
      "titleEn": "Yes/no questions",
      "blocks": [
        { "type": "p", "text": "To ask a yes/no question, move the verb first and add -ko or -kö (vowel harmony)." },
        { "type": "table", "head": ["Statement", "Question", "Puhekieli"], "rows": [["Puhut suomea.", "Puhutko suomea?", "Puhuks sä suomee?"], ["Syöt kalaa.", "Syötkö kalaa?", "Syöks sä kalaa?"], ["Se on auki.", "Onko se auki?", "Onks se auki?"]] },
        { "type": "tip", "text": "In speech -ko/-kö usually shrinks to -ks: onks, puhuks, haluuks." }
      ]
    },
    {
      "id": "g_conditional_polite",
      "title": "Kohtelias pyyntö",
      "titleEn": "Polite requests with -isi-",
      "blocks": [
        { "type": "p", "text": "Add -isi- to the verb stem to make it conditional — 'would'. It is the easiest way to sound polite." },
        { "type": "table", "head": ["Verb", "I would…", "Example"], "rows": [["haluta", "haluaisin", "Haluaisin kahvia."], ["ottaa", "ottaisin", "Ottaisin pullan."], ["voida", "voisitko? (could you?)", "Voisitko auttaa?"]] },
        { "type": "tip", "text": "Finns rarely say 'please'. Politeness lives in the conditional and in a friendly 'kiitos' at the end." }
      ]
    }
  ]
}
