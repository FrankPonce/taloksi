      ],
      "sentences": [
        { "id": "s_u3l1_1", "fi": "Syön leipää ja juustoa.", "en": "I eat bread and cheese.", "altEn": ["I am eating bread and cheese."], "puhe": "Mä syön leipää ja juustoo.", "speaker": "mikko" },
        { "id": "s_u3l1_2", "fi": "Ruisleipä on hyvää.", "en": "Rye bread is good.", "altEn": ["The rye bread is good.", "Rye bread is tasty."], "speaker": "helvi" },
        { "id": "s_u3l1_3", "fi": "Haluan omenan.", "en": "I want an apple.", "altEn": ["I would like an apple."], "puhe": "Mä haluun omenan.", "speaker": "helvi" },
        { "id": "s_u3l1_4", "fi": "Syötkö kalaa?", "en": "Do you eat fish?", "puhe": "Syöks sä kalaa?", "speaker": "samir" },
        { "id": "s_u3l1_5", "fi": "En syö lihaa.", "en": "I don't eat meat.", "puhe": "Mä en syö lihaa.", "speaker": "anna" }
      ],
      "fill": [
        { "id": "f_u3l1_1", "before": "Syön", "after": ".", "answer": "leipää", "options": ["leipä", "leipää", "leivän"], "en": "I eat (some) bread.", "hint": "Uncountable food → partitive." },
        { "id": "f_u3l1_2", "before": "En syö", "after": ".", "answer": "lihaa", "options": ["liha", "lihaa", "lihan"], "en": "I don't eat meat.", "hint": "After a negative verb the object is always partitive." }
      ]
    },
