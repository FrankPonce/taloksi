  "grammar": [
    {
      "id": "g_locative",
      "title": "Missä? Mistä? Mihin?",
      "titleEn": "In, from, into: the inner cases",
      "blocks": [
        { "type": "p", "text": "Finnish has no prepositions like 'in' or 'from'. Instead, endings go on the noun." },
        { "type": "table", "head": ["Question", "Ending", "talo (house)", "Suomi"], "rows": [["Missä? (where)", "-ssa / -ssä", "talossa", "Suomessa"], ["Mistä? (from where)", "-sta / -stä", "talosta", "Suomesta"], ["Mihin? (to where)", "-Vn / -hVn / -seen", "taloon", "Suomeen"]] },
        { "type": "tip", "text": "Vowel harmony: if the word has a, o or u, use -ssa/-sta. If it only has ä, ö, y, e or i, use -ssä/-stä: Helsinki → Helsingissä." },
        { "type": "example", "fi": "Olen kotoisin Espanjasta, mutta asun Suomessa.", "en": "I'm from Spain, but I live in Finland." }
      ]
    },
    {
      "id": "g_partitive_intro",
      "title": "Partitiivi (1)",
      "titleEn": "The partitive, part 1",
      "blocks": [
        { "type": "p", "text": "The partitive is Finland's most-used case. Two easy places to start: languages after 'puhua', and nouns after numbers (2 and up)." },
        { "type": "table", "head": ["Basic form", "Partitive", "Example"], "rows": [["suomi", "suomea", "Puhun suomea."], ["englanti", "englantia", "Puhutko englantia?"], ["sisko", "siskoa", "kaksi siskoa"], ["euro", "euroa", "viisi euroa"]] },
        { "type": "tip", "text": "The ending is -a/-ä (or -ta/-tä after a long vowel or consonant). Words ending in -i often change to -e first: suomi → suomea." }
      ]
    },
    {
      "id": "g_verbs_present",
      "title": "Verbit: preesens",
      "titleEn": "Verbs in the present tense",
      "blocks": [
        { "type": "p", "text": "Take the infinitive (asua), drop the -a/-ä to get the stem (asu-), then add the personal ending." },
        { "type": "table", "head": ["Person", "Ending", "asua", "Puhekieli"], "rows": [["minä", "-n", "asun", "mä asun"], ["sinä", "-t", "asut", "sä asut"], ["hän", "vowel doubles", "asuu", "se asuu"], ["me", "-mme", "asumme", "me asutaan"], ["te", "-tte", "asutte", "te asutte"], ["he", "-vat / -vät", "asuvat", "ne asuu"]] },
        { "type": "tip", "text": "Spoken Finnish uses the passive form for 'we' (me asutaan), and the 'he/she' form for 'they' (ne asuu). Nobody will think it's wrong — it's how almost everyone talks." }
      ]
    }
  ]
