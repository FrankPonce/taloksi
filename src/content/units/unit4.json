  "grammar": [
    {
      "id": "g_gradation",
      "title": "Astevaihtelu",
      "titleEn": "Consonant gradation",
      "blocks": [
        { "type": "p", "text": "Many words change k, p or t in the middle when an ending is added. It looks scary, but there are only a handful of patterns." },
        { "type": "table", "head": ["Change", "Basic form", "With ending"], "rows": [["kk → k", "pankki", "pankissa"], ["pp → p", "kauppa", "kaupassa"], ["tt → t", "kortti", "kortilla"], ["t → d", "katu", "kadulla"], ["nk → ng", "Helsinki", "Helsingissä"], ["rk → r", "Turku", "Turussa"], ["nt → nn", "ranta", "rannalla"]] },
        { "type": "tip", "text": "Rule of thumb: the weak form shows up when the ending closes the syllable (-n, -ssa, -sta, -lla, -lta, -lle, -t). The strong form stays before long endings like -an or -seen: kauppaan, katuun." }
      ]
    },
    {
      "id": "g_external",
      "title": "Ulkopaikallissijat",
      "titleEn": "On, off, onto: the outer cases",
      "blocks": [
        { "type": "p", "text": "Three more location endings, for being on a surface, at a place, or near it." },
        { "type": "table", "head": ["Question", "Ending", "pöytä (table)", "asema (station)"], "rows": [["Missä? (on / at)", "-lla / -llä", "pöydällä", "asemalla"], ["Mistä? (off / from)", "-lta / -ltä", "pöydältä", "asemalta"], ["Mihin? (onto / to)", "-lle", "pöydälle", "asemalle"]] },
        { "type": "tip", "text": "The same -lla is used for 'by' (bussilla = by bus) and for having: 'Minulla on…' = I have…" }
      ]
    },
    {
      "id": "g_illative",
      "title": "Mihin? Illatiivi",
      "titleEn": "Going into: the illative",
      "blocks": [
        { "type": "p", "text": "The illative (into) has a few shapes. Most short words repeat their last vowel and add -n." },
        { "type": "table", "head": ["Word", "Into", "Pattern"], "rows": [["talo", "taloon", "double vowel + n"], ["kauppa", "kauppaan", "double vowel + n"], ["Helsinki", "Helsinkiin", "double vowel + n"], ["Suomi", "Suomeen", "i → e, then double + n"], ["maa", "maahan", "long vowel: -hVn"], ["huone", "huoneeseen", "-e words: -seen"]] },
        { "type": "example", "fi": "Mennään kotiin!", "en": "Let's go home!" }
      ]
    },
    {
      "id": "g_possession",
      "title": "Minulla on",
      "titleEn": "How to say 'I have'",
      "blocks": [
        { "type": "p", "text": "Finnish has no verb 'to have'. You say 'at me is': the owner takes -lla/-llä and the verb is always 'on'." },
        { "type": "table", "head": ["Kirjakieli", "Puhekieli", "English"], "rows": [["minulla on", "mulla on", "I have"], ["sinulla on", "sulla on", "you have"], ["hänellä on", "sillä on", "he/she has"], ["meillä on", "meil on", "we have"], ["teillä on", "teil on", "you (pl.) have"], ["heillä on", "niil on", "they have"]] },
        { "type": "example", "fi": "Minulla on kaksi siskoa.", "en": "I have two sisters.", "puhe": "Mulla on kaks siskoo." }
