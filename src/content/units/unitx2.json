  "grammar": [
    {
      "id": "g_plural_places",
      "title": "Bileisiin, bileissä, bileistä",
      "titleEn": "Events that are always plural",
      "blocks": [
        { "type": "p", "text": "Many Finnish words for events exist only in the plural: bileet (party), juhlat (celebration), treffit (date), jatkot (afterparty), häät (wedding), hautajaiset (funeral). To say you are going to one, you need the plural location endings." },
        { "type": "table", "head": ["Question", "Ending", "Example"], "rows": [["Mihin? (to)", "-isiin / -ille", "Menen bileisiin."], ["Missä? (at)", "-issä / -illa", "Olen bileissä."], ["Mistä? (from)", "-istä / -ilta", "Tulen bileistä."]] },
        { "type": "tip", "text": "The plural marker is -i-, squeezed between the stem and the ending: bile + i + ssä. Treffit and jatkot use the 'on' set instead: treffeillä, jatkoilla." },
        { "type": "example", "fi": "Tuletko bileisiin?", "en": "Are you coming to the party?", "puhe": "Tuuks sä bileisiin?" },
        { "type": "example", "fi": "Mennäänkö jatkoille?", "en": "Shall we go to the afterparty?", "puhe": "Mennääks jatkoille?" }
      ]
    },
    {
      "id": "g_feelings",
      "title": "Minulla on ikävä",
      "titleEn": "Feelings you 'have'",
      "blocks": [
        { "type": "p", "text": "English says 'I am hungry' and 'I miss you'. Finnish often says you have the feeling, using the same 'minulla on' you know from owning things." },
        { "type": "table", "head": ["Finnish", "Literally", "Meaning"], "rows": [["Minulla on nälkä.", "I have hunger", "I am hungry."], ["Minulla on jano.", "I have thirst", "I am thirsty."], ["Minulla on kylmä.", "I have cold", "I am cold."], ["Minulla on ikävä sinua.", "I have a longing for you", "I miss you."], ["Minulla on krapula.", "I have a hangover", "I am hungover."]] },
        { "type": "example", "fi": "Minulla on ikävä sinua.", "en": "I miss you.", "puhe": "Mulla on ikävä sua." },
        { "type": "tip", "text": "Being angry, tired or jealous works like English, with olla plus an adjective: Olen vihainen, olen väsynyt, olen mustasukkainen." }
      ]
    }
  ]
