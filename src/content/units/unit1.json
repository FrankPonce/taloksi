  ],
  "grammar": [
    {
      "id": "g_pronunciation",
      "title": "Ääntäminen",
      "titleEn": "Pronunciation basics",
      "blocks": [
        { "type": "p", "text": "Finnish is written almost exactly as it sounds: every letter is pronounced, always the same way." },
        { "type": "p", "text": "Stress is always on the first syllable of a word: HUO-men-ta, NÄ-ke-miin." },
        { "type": "table", "head": ["Letter", "Sounds like"], "rows": [["a", "a in 'father' (short)"], ["ä", "a in 'cat'"], ["ö", "i in 'bird' (German ö)"], ["y", "German ü — say 'ee' with rounded lips"], ["r", "rolled / trilled r"], ["j", "y in 'yes'"]] },
        { "type": "p", "text": "Double letters are long, and length changes the meaning:" },
        { "type": "example", "fi": "tuli – tuuli – tulli", "en": "fire – wind – customs" },
        { "type": "example", "fi": "kansa – kanssa", "en": "people – with" },
        { "type": "tip", "text": "Exaggerate long sounds at first. Finns notice length much more than accent." }
      ]
    },
    {
      "id": "g_olla",
      "title": "Olla – olla-verbi",
      "titleEn": "The verb 'to be'",
      "blocks": [
        { "type": "p", "text": "Olla (to be) is irregular in the 3rd person, but the endings -n, -t, -mme, -tte are the same for almost every verb." },
        { "type": "table", "head": ["Kirjakieli", "Puhekieli", "English"], "rows": [["minä olen", "mä oon", "I am"], ["sinä olet", "sä oot", "you are"], ["hän on", "se on", "he/she is"], ["me olemme", "me ollaan", "we are"], ["te olette", "te ootte", "you (pl.) are"], ["he ovat", "ne on", "they are"]] },
        { "type": "tip", "text": "In standard Finnish you can drop minä/sinä/me/te because the ending already shows the person: 'Olen Anna.' In spoken Finnish people usually keep the pronoun: 'Mä oon Anna.'" },
        { "type": "example", "fi": "Olen opiskelija.", "en": "I am a student.", "puhe": "Mä oon opiskelija." }
      ]
    },
    {
      "id": "g_negation",
      "title": "Kieltoverbi",
      "titleEn": "Saying no: the negative verb",
      "blocks": [
        { "type": "p", "text": "Finnish negates with a verb of its own, 'ei', which takes the personal ending. The main verb drops its ending." },
        { "type": "table", "head": ["Kirjakieli", "Puhekieli", "English"], "rows": [["en puhu", "mä en puhu", "I don't speak"], ["et puhu", "sä et puhu", "you don't speak"], ["ei puhu", "se ei puhu", "he/she doesn't speak"], ["emme puhu", "me ei puhuta", "we don't speak"], ["ette puhu", "te ette puhu", "you (pl.) don't speak"], ["eivät puhu", "ne ei puhu", "they don't speak"]] },
        { "type": "example", "fi": "En ymmärrä.", "en": "I don't understand." },
        { "type": "tip", "text": "To answer a yes/no question, Finns usually repeat the verb: 'Puhutko suomea?' – 'Puhun.' / 'En puhu.'" }
      ]
    }
  ]
}
