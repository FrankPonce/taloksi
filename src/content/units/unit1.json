        { "id": "w_moi", "fi": "moi", "en": "hi (casual)", "altEn": ["hi", "hello", "hey"], "note": "Very common in speech and texts. 'Moi moi' means bye.", "pos": "phrase", "icon": "hand-wave-outline" },
        { "id": "w_huomenta", "fi": "huomenta", "en": "good morning", "pos": "phrase", "icon": "weather-sunset-up" },
        { "id": "w_hyvaa_paivaa", "fi": "hyvää päivää", "en": "good day", "altEn": ["good afternoon"], "note": "Formal. In everyday life people just say 'hei' or 'moi'.", "pos": "phrase", "icon": "white-balance-sunny" },
        { "id": "w_hei_hei", "fi": "hei hei", "en": "bye", "altEn": ["bye bye", "goodbye"], "pos": "phrase", "icon": "exit-run" },
        { "id": "w_nakemiin", "fi": "näkemiin", "en": "goodbye", "altEn": ["bye"], "pos": "phrase", "icon": "door-open" }
      ],
      "sentences": [
        { "id": "s_u1l1_1", "fi": "Hei, minä olen Anna.", "en": "Hi, I am Anna.", "altEn": ["Hello, I am Anna."], "altFi": ["Hei, olen Anna."], "puhe": "Moi, mä oon Anna.", "speaker": "anna" },
        { "id": "s_u1l1_2", "fi": "Huomenta, Pekka!", "en": "Good morning, Pekka!", "speaker": "anna" },
        { "id": "s_u1l1_3", "fi": "Hei hei, Anna!", "en": "Bye, Anna!", "altEn": ["Bye bye, Anna!", "Goodbye, Anna!"], "puhe": "Moi moi, Anna!", "speaker": "pekka" },
        { "id": "s_u1l1_4", "fi": "Minä olen Pekka.", "en": "I am Pekka.", "altFi": ["Olen Pekka."], "puhe": "Mä oon Pekka.", "speaker": "pekka" },
        { "id": "s_u1l1_5", "fi": "Hei, sinä olet Anna.", "en": "Hi, you are Anna.", "altEn": ["Hello, you are Anna."], "puhe": "Moi, sä oot Anna.", "speaker": "pekka" }
      ],
      "fill": [
        { "id": "f_u1l1_1", "before": "Minä", "after": "Anna.", "answer": "olen", "options": ["olen", "olet", "on"], "en": "I am Anna." }
      ]
    },
    {
