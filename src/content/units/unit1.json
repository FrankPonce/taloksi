        { "id": "w_nimi", "fi": "nimi", "en": "name", "pos": "noun", "icon": "card-account-details" }
      ],
      "sentences": [
        { "id": "s_u1l3_1", "fi": "Kuka sinä olet?", "en": "Who are you?", "altFi": ["Kuka olet?"], "puhe": "Kuka sä oot?", "speaker": "helvi" },
        { "id": "s_u1l3_2", "fi": "Minun nimeni on Anna.", "en": "My name is Anna.", "altFi": ["Nimeni on Anna."], "puhe": "Mun nimi on Anna.", "speaker": "anna" },
        { "id": "s_u1l3_3", "fi": "Mikä sinun nimesi on?", "en": "What is your name?", "altFi": ["Mikä nimesi on?"], "puhe": "Mikä sun nimi on?", "speaker": "mikko" },
        { "id": "s_u1l3_4", "fi": "Hän on Pekka.", "en": "He is Pekka.", "puhe": "Se on Pekka.", "speaker": "samir" },
        { "id": "s_u1l3_5", "fi": "Me olemme ystäviä.", "en": "We are friends.", "altFi": ["Olemme ystäviä."], "puhe": "Me ollaan kavereita.", "speaker": "anna" },
        { "id": "s_u1l3_6", "fi": "He ovat opiskelijoita.", "en": "They are students.", "puhe": "Ne on opiskelijoita.", "speaker": "anna" }
