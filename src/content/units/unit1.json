        { "id": "w_ole_hyva", "fi": "ole hyvä", "en": "you're welcome", "altEn": ["here you go", "here you are", "you are welcome"], "note": "Said when handing something over or replying to thanks.", "pos": "phrase", "icon": "gift" },
        { "id": "w_kiitos_paljon", "fi": "kiitos paljon", "en": "thank you very much", "altEn": ["thanks a lot", "thank you so much", "many thanks"], "pos": "phrase", "icon": "hand-clap" },
        { "id": "w_kylla", "fi": "kyllä", "en": "yes", "puhe": "joo", "pos": "particle", "icon": "check-bold" },
        { "id": "w_ei", "fi": "ei", "en": "no", "pos": "particle", "icon": "close-thick" },
        { "id": "w_joo", "fi": "joo", "en": "yeah", "altEn": ["yes"], "pos": "particle", "icon": "check" }
      ],
      "sentences": [
        { "id": "s_u1l4_1", "fi": "Anteeksi, en ymmärrä.", "en": "Sorry, I don't understand.", "altEn": ["Excuse me, I don't understand."], "puhe": "Sori, mä en ymmärrä.", "speaker": "anna" },
        { "id": "s_u1l4_2", "fi": "Kiitos paljon, Anna!", "en": "Thank you very much, Anna!", "altEn": ["Thanks a lot, Anna!", "Thank you so much, Anna!"], "speaker": "pekka" },
        { "id": "s_u1l4_3", "fi": "Puhutko englantia?", "en": "Do you speak English?", "puhe": "Puhuks sä englantia?", "speaker": "anna" },
        { "id": "s_u1l4_4", "fi": "Kyllä, puhun.", "en": "Yes, I do.", "altEn": ["Yes, I speak.", "Yes, I speak it."], "puhe": "Joo, puhun.", "speaker": "pekka" },
        { "id": "s_u1l4_5", "fi": "Ei, en puhu.", "en": "No, I don't.", "altEn": ["No, I don't speak.", "No, I don't speak it."], "speaker": "pekka" },
        { "id": "s_u1l4_6", "fi": "Voitko puhua hitaammin?", "en": "Can you speak more slowly?", "altEn": ["Could you speak more slowly?", "Can you speak slower?"], "puhe": "Voitsä puhuu hitaammin?", "speaker": "helvi" }
      ],
      "fill": [
        { "id": "f_u1l4_1", "before": "Anteeksi, en", "after": ".", "answer": "ymmärrä", "options": ["ymmärrä", "ymmärrän", "ymmärtää"], "en": "Sorry, I don't understand.", "hint": "After the negative verb (en, et, ei…) the main verb loses its personal ending." }
      ]
