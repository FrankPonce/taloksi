        { "id": "w_hyvaa", "fi": "hyvää", "en": "good", "altEn": ["fine", "well"], "pos": "adj", "icon": "emoticon-happy" },
        { "id": "w_kiitos", "fi": "kiitos", "en": "thank you", "altEn": ["thanks", "please"], "note": "Also used like 'please' when ordering: 'Kahvi, kiitos.'", "pos": "phrase", "icon": "hand-heart" },
        { "id": "w_enta_sinulle", "fi": "entä sinulle", "en": "and you", "altEn": ["what about you", "how about you"], "puhe": "entä sulle", "pos": "phrase" },
        { "id": "w_ihan_hyvaa", "fi": "ihan hyvää", "en": "pretty good", "altEn": ["quite good", "just fine", "fine"], "pos": "phrase", "icon": "emoticon-neutral" },
        { "id": "w_huonoa", "fi": "huonoa", "en": "bad", "altEn": ["not good"], "pos": "adj", "icon": "thumb-down" }
      ],
      "sentences": [
        { "id": "s_u1l2_1", "fi": "Hei, mitä kuuluu?", "en": "Hi, how are you?", "altEn": ["Hello, how are you?"], "puhe": "Moi, mitä kuuluu?", "speaker": "anna" },
        { "id": "s_u1l2_2", "fi": "Kiitos, hyvää.", "en": "Fine, thanks.", "altEn": ["Good, thanks.", "Thanks, good.", "Fine, thank you.", "Good, thank you.", "Thank you, fine.", "Thank you, good."], "speaker": "samir" },
        { "id": "s_u1l2_3", "fi": "Entä sinulle?", "en": "And you?", "altEn": ["What about you?", "How about you?"], "puhe": "Entä sulle?", "speaker": "anna" },
        { "id": "s_u1l2_4", "fi": "Ihan hyvää, kiitos.", "en": "Pretty good, thanks.", "altEn": ["Pretty good, thank you.", "Quite good, thanks.", "Fine, thanks."], "speaker": "helvi" },
        { "id": "s_u1l2_5", "fi": "Minulle kuuluu hyvää.", "en": "I am doing well.", "altEn": ["I am doing fine.", "I am fine.", "I am well."], "puhe": "Mulle kuuluu hyvää.", "speaker": "mikko" }
      ],
      "fill": [
        { "id": "f_u1l2_1", "before": "Mitä", "after": "?", "answer": "kuuluu", "options": ["kuuluu", "kiitos", "hyvää"], "en": "How are you?" }
      ]
    },
