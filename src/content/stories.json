      { "id": "st_kahvila_4", "speaker": "Sofia", "speakerId": "sofia", "fi": "Ja yksi korvapuusti.", "en": "And one cinnamon roll." },
      { "id": "st_kahvila_5", "speaker": "Myyjä", "speakerId": "aino", "fi": "Täällä vai mukaan?", "en": "For here or to go?" },
