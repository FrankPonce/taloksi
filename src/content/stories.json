      { "id": "st_naapuri_6", "speaker": "Pekka", "speakerId": "pekka", "fi": "Puhut hyvin suomea!", "en": "You speak Finnish well!" },
      { "id": "st_naapuri_7", "speaker": "Sofia", "speakerId": "sofia", "fi": "Kiitos! Puhun vähän. Opiskelen yliopistossa.", "en": "Thanks! I speak a little. I study at the university." },
      { "id": "st_naapuri_8", "speaker": "Pekka", "speakerId": "pekka", "fi": "Tervetuloa!", "en": "Welcome!" }
    ],
