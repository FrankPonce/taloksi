    "lines": [
      { "id": "st_kahvila_1", "speaker": "Myyjä", "speakerId": "aino", "fi": "Hei! Mitä saisi olla?", "en": "Hi! What can I get you?" },
      { "id": "st_kahvila_2", "speaker": "Anna", "speakerId": "anna", "fi": "Hei! Haluaisin kupin kahvia, kiitos.", "en": "Hi! I'd like a cup of coffee, please." },
      { "id": "st_kahvila_3", "speaker": "Myyjä", "speakerId": "aino", "fi": "Tuleeko muuta?", "en": "Anything else?" },
      { "id": "st_kahvila_4", "speaker": "Anna", "speakerId": "anna", "fi": "Ja yksi korvapuusti.", "en": "And one cinnamon roll." },
      { "id": "st_kahvila_5", "speaker": "Myyjä", "speakerId": "aino", "fi": "Täällä vai mukaan?", "en": "For here or to go?" },
      { "id": "st_kahvila_6", "speaker": "Anna", "speakerId": "anna", "fi": "Täällä. Paljonko se maksaa?", "en": "For here. How much is it?" },
      { "id": "st_kahvila_7", "speaker": "Myyjä", "speakerId": "aino", "fi": "Seitsemän euroa.", "en": "Seven euros." },
      { "id": "st_kahvila_8", "speaker": "Anna", "speakerId": "anna", "fi": "Voinko maksaa kortilla?", "en": "Can I pay by card?" },
      { "id": "st_kahvila_9", "speaker": "Myyjä", "speakerId": "aino", "fi": "Totta kai. Kiitos!", "en": "Of course. Thank you!" },
      { "id": "st_kahvila_10", "speaker": "Anna", "speakerId": "anna", "fi": "Kiitos, hei hei!", "en": "Thanks, bye!" }
    ],
    "questions": [
      { "q": "What does Anna order?", "choices": ["Tea and a cinnamon roll", "Coffee and a cinnamon roll", "Coffee and rye bread"], "answer": 1 },
