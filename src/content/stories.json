      { "id": "st_naapuri_1", "speaker": "Pekka", "speakerId": "pekka", "fi": "Hei! Oletko sinä uusi naapuri?", "en": "Hi! Are you the new neighbour?" },
      { "id": "st_naapuri_2", "speaker": "Anna", "speakerId": "anna", "fi": "Hei! Olen. Minun nimeni on Anna.", "en": "Hi! I am. My name is Anna." },
      { "id": "st_naapuri_3", "speaker": "Pekka", "speakerId": "pekka", "fi": "Hauska tutustua, Anna. Minä olen Pekka.", "en": "Nice to meet you, Anna. I'm Pekka." },
      { "id": "st_naapuri_4", "speaker": "Pekka", "speakerId": "pekka", "fi": "Mistä sinä olet kotoisin?", "en": "Where are you from?" },
      { "id": "st_naapuri_5", "speaker": "Anna", "speakerId": "anna", "fi": "Olen kotoisin Espanjasta, mutta asun nyt Turussa.", "en": "I'm from Spain, but now I live in Turku." },
      { "id": "st_naapuri_6", "speaker": "Pekka", "speakerId": "pekka", "fi": "Puhut hyvin suomea!", "en": "You speak Finnish well!" },
      { "id": "st_naapuri_7", "speaker": "Anna", "speakerId": "anna", "fi": "Kiitos! Puhun vähän. Opiskelen yliopistossa.", "en": "Thanks! I speak a little. I study at the university." },
      { "id": "st_naapuri_8", "speaker": "Pekka", "speakerId": "pekka", "fi": "Tervetuloa Turkuun!", "en": "Welcome to Turku!" }
    ],
    "questions": [
      { "q": "Where is Anna from?", "choices": ["Finland", "Spain", "Sweden"], "answer": 1 },
      { "q": "Where does Anna live now?", "choices": ["Helsinki", "Turku", "Madrid"], "answer": 1 },
      { "q": "What does Pekka say about Anna's Finnish?", "choices": ["She speaks it well", "She doesn't speak it", "She speaks Swedish instead"], "answer": 0 },
      { "q": "What does Anna do?", "choices": ["Works at a café", "Studies at the university", "Drives a bus"], "answer": 1 }
    ]
  },
  {
